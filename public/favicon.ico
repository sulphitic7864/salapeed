<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="100%">
  <defs>
    <filter id="neon-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <rect width="800" height="240" fill="#050505" />
  
  <g transform="skewX(-16) translate(40, 20)">
    <!-- Speed Flame Trails from the S -->
    <path d="M 120 40 Q 70 30 20 48 Q 60 58 100 60 Q 50 68 10 82 Q 70 85 110 88 Q 40 100 0 118 Q 60 115 120 116 Q 30 135 0 160 Q 60 148 130 140 Q 40 168 15 195 Q 80 175 160 160" 
          fill="none" stroke="#39FF14" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M 120 40 Q 70 30 20 48 Q 60 58 100 60 Q 50 68 10 82 Q 70 85 110 88 Q 40 100 0 118 Q 60 115 120 116 Q 30 135 0 160 Q 60 148 130 140 Q 40 168 15 195 Q 80 175 160 160 Z" 
          fill="#39FF14" opacity="0.9" />

    <!-- Foreground stylized word SALAPEED -->
    <text x="140" y="160" 
          font-family="system-ui, -apple-system, sans-serif" 
          font-size="132" 
          font-weight="900" 
          font-style="italic" 
          letter-spacing="-4" 
          fill="#050505" 
          stroke="#39FF14" 
          stroke-width="12" 
          stroke-linejoin="miter" 
          paint-order="stroke fill">SALAPEED</text>
    <text x="140" y="160" 
          font-family="system-ui, -apple-system, sans-serif" 
          font-size="132" 
          font-weight="900" 
          font-style="italic" 
          letter-spacing="-4" 
          fill="#0a0a0a">SALAPEED</text>
  </g>
</svg>
